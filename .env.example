# Stripe Configuration
# Get these from your Stripe dashboard: https://dashboard.stripe.com/apikeys

# Publishable key (safe for client-side)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Price IDs for credit packs
# Create these in Stripe Dashboard > Products
VITE_STRIPE_STARTER_PRICE_ID=price_1234567890starter
VITE_STRIPE_PROFESSIONAL_PRICE_ID=price_1234567890professional
VITE_STRIPE_ENTERPRISE_PRICE_ID=price_1234567890enterprise

# Price IDs for services
VITE_STRIPE_AGENCY_PRICE_ID=price_1234567890agency
VITE_STRIPE_INSTANT_SITE_PRICE_ID=price_1234567890instant

# Other environment variables
VITE_API_URL=http://localhost:3000
