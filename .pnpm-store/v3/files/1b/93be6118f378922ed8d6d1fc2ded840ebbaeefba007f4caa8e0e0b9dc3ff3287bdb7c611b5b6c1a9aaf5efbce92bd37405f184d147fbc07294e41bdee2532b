<!doctype html><html class="dark"><head><meta charset="utf-8"><title>Golden ramp</title><link rel="stylesheet" href="../styles.css">
<style>body{margin:0;padding:16px 20px;background:#000;font-family:var(--font-sans);color:var(--foreground)}
