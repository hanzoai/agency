<!-- @dsCard group="Colors" viewport="700x150" name="Opacity ladder" subtitle="The real palette: one hue, nine steps. Rank = opacity" -->
<!doctype html><html class="dark"><head><meta charset="utf-8"><title>Opacity ladder</title><link rel="stylesheet" href="../styles.css">
<style>body{margin:0;padding:16px 20px;background:#000;font-family:var(--font-sans);color:var(--foreground)}
.g{display:flex;gap:10px;flex-wrap:wrap}.sw{flex:1;min-width:64px}.chip{height:56px;border-radius:8px;border:1px solid var(--white-10)}
.n{margin-top:6px;font-size:10px;font-weight:600;letter-spacing:.06em;color:var(--neutral-300);font-family:var(--font-mono)}
.v{font-size:9px;color:var(--neutral-600);font-family:var(--font-mono)}
.row{display:flex;align-items:baseline;gap:14px}.mono{font-family:var(--font-mono)}
.meta{font-size:10px;color:var(--neutral-600);font-family:var(--font-mono);white-space:nowrap}
</style></head><body>
<div class="g">
  <div class="sw" style="min-width:44px"><div class="chip" style="background:rgb(255 255 255 / 0.05)"></div><div class="n">/5</div></div>
  <div class="sw" style="min-width:44px"><div class="chip" style="background:rgb(255 255 255 / 0.1)"></div><div class="n">/10</div></div>
  <div class="sw" style="min-width:44px"><div class="chip" style="background:rgb(255 255 255 / 0.15)"></div><div class="n">/15</div></div>
  <div class="sw" style="min-width:44px"><div class="chip" style="background:rgb(255 255 255 / 0.2)"></div><div class="n">/20</div></div>
  <div class="sw" style="min-width:44px"><div class="chip" style="background:rgb(255 255 255 / 0.3)"></div><div class="n">/30</div></div>
  <div class="sw" style="min-width:44px"><div class="chip" style="background:rgb(255 255 255 / 0.4)"></div><div class="n">/40</div></div>
  <div class="sw" style="min-width:44px"><div class="chip" style="background:rgb(255 255 255 / 0.6)"></div><div class="n">/60</div></div>
  <div class="sw" style="min-width:44px"><div class="chip" style="background:rgb(255 255 255 / 0.8)"></div><div class="n">/80</div></div>
  <div class="sw" style="min-width:44px"><div class="chip" style="background:rgb(255 255 255 / 1)"></div><div class="n">white</div></div>
</div>
<div class="meta" style="margin-top:10px">tier badges: /5 edge · /15 pro · /20 ultra — never hue</div>
</body></html>