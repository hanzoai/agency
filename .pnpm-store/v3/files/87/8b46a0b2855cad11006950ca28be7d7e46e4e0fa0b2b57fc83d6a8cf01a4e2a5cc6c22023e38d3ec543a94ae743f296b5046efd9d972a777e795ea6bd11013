/** The names this package has outlines for. */
export const WORDMARK_NAMES = Object.keys(WORDMARKS);
/**
 * One wordmark as a standalone SVG, already flipped to screen coordinates.
 *
 * Returns null for a name with no outline rather than falling back to <text> —
 * a silent fallback is how a page ends up setting the brand in Arial. Add the
 * name to scripts/wordmarks.py and re-run it.
 */
export function getWordmarkSVG(name, fill = 'currentColor') {
    const w = WORDMARKS[name];
    if (!w)
        return null;
    const [x, y, width, height] = w.box;
    return (`<svg role="img" aria-label="${name}" viewBox="${x} ${-y - height} ${width} ${height}" ` +
        `xmlns="http://www.w3.org/2000/svg">` +
        `<g transform="scale(1,-1)"><path d="${w.d}" fill="${fill}"/></g>` +
        `</svg>`);
}
