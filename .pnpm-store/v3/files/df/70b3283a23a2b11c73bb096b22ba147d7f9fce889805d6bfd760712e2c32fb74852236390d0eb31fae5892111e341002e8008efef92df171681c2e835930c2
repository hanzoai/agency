<!-- @dsCard group="Type" viewport="700x220" name="Display" subtitle="Geist Sans, hero and section headlines" -->
<!doctype html><html class="dark"><head><meta charset="utf-8"><title>Display type</title><link rel="stylesheet" href="../styles.css">
<style>body{margin:0;padding:16px 20px;background:#000;font-family:var(--font-sans);color:var(--foreground)}
.g{display:flex;gap:10px;flex-wrap:wrap}.sw{flex:1;min-width:64px}.chip{height:56px;border-radius:8px;border:1px solid var(--white-10)}
.n{margin-top:6px;font-size:10px;font-weight:600;letter-spacing:.06em;color:var(--neutral-300);font-family:var(--font-mono)}
.v{font-size:9px;color:var(--neutral-600);font-family:var(--font-mono)}
.row{display:flex;align-items:baseline;gap:14px}.mono{font-family:var(--font-mono)}
.meta{font-size:10px;color:var(--neutral-600);font-family:var(--font-mono);white-space:nowrap}
</style></head><body>
<div style="display:flex;flex-direction:column;gap:10px">
  <div class="row"><span style="font-size:var(--text-6xl);font-weight:700;letter-spacing:var(--tracking-tight);line-height:1">Enso</span><span class="meta">6xl / 60px · 700 · tracking-tight</span></div>
  <div class="row"><span style="font-size:var(--text-4xl);font-weight:700;letter-spacing:var(--tracking-tight);line-height:1.1">The AI cloud for agents</span><span class="meta">4xl / 36px · 700</span></div>
  <div class="row"><span style="font-size:var(--text-2xl);font-weight:600">Section subhead</span><span class="meta">2xl / 24px · 600</span></div>
</div></body></html>