  <div class="i"><i data-lucide="message-square" style="width:22px;height:22px"></i><span class="n">message-square</span></div>
  <div class="i"><i data-lucide="search" style="width:22px;height:22px"></i><span class="n">search</span></div>
  <div class="i"><i data-lucide="chevron-down" style="width:22px;height:22px"></i><span class="n">chevron-down</span></div>
