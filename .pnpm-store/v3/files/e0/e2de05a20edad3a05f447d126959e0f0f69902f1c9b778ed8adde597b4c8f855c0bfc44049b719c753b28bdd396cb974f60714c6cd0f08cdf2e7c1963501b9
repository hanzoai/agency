  <div class="i"><i data-lucide="file-text" style="width:22px;height:22px"></i><span class="n">file-text</span></div>
  <div class="i"><i data-lucide="settings" style="width:22px;height:22px"></i><span class="n">settings</span></div>
  <div class="i"><i data-lucide="user-check" style="width:22px;height:22px"></i><span class="n">user-check</span></div>
  <div class="i"><i data-lucide="shield-check" style="width:22px;height:22px"></i><span class="n">shield-check</span></div>
  <div class="i"><i data-lucide="lock" style="width:22px;height:22px"></i><span class="n">lock</span></div>
  <div class="i"><i data-lucide="key-round" style="width:22px;height:22px"></i><span class="n">key-round</span></div>
  <div class="i"><i data-lucide="cloud" style="width:22px;height:22px"></i><span class="n">cloud</span></div>
  <div class="i"><i data-lucide="database" style="width:22px;height:22px"></i><span class="n">database</span></div>
